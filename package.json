{
  "name": "@mgcrea/react-native-swiftui",
  "version": "0.18.0",
  "description": "SwiftUI components for React Native",
  "author": "Olivier Louvignes <olivier@mgcrea.io> (https://github.com/mgcrea)",
  "homepage": "https://github.com/mgcrea/react-native-swiftui#readme",
  "repository": "github:mgcrea/react-native-swiftui",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "*.podspec",
    "nitro.json",
    "src",
    "dist",
    "ios",
    "nitrogen/generated"
  ],
  "scripts": {
    "dev": "cd example; npm run dev",
    "build": "npm run build:babel && npm run build:types && npm run nitrogen",
    "build:babel": "rm -rf dist && babel src --out-dir dist --extensions \".ts,.tsx,.js,.jsx\" --copy-files --no-copy-ignored --ignore \"src/**/*.test.ts,src/**/*.test.tsx\"",
    "build:types": "tsc --emitDeclarationOnly && tsc-alias",
    "install:ios": "cd example; npm run install:ios",
    "open:ios": "cd example; npm run open:ios",
    "nitrogen": "npx nitrogen",
    "changelog": "node scripts/generate-changelog.mjs > CHANGELOG.md",
    "release": "release-it",
    "lint": "oxlint --deny-warnings --report-unused-disable-directives src/",
    "format": "oxfmt --write src/ scripts/",
    "format:check": "oxfmt --check src/ scripts/",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "check:props": "node scripts/check-props-parity.mjs",
    "spec": "NODE_OPTIONS=--experimental-require-module jest",
    "test": "npm run lint && npm run check && npm run check:props && npm run spec",
    "prepare": "npm run build"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-nitro-modules": "*"
  },
  "devDependencies": {
    "@babel/cli": "^7.26.4",
    "@babel/core": "^7.26.9",
    "@babel/runtime": "^7.26.9",
    "@jest/globals": "^29.7.0",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "^19.2.18",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "nitrogen": "^0.36.5",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.81.0",
    "react": "19.2.8",
    "react-native": "0.86.2",
    "react-native-nitro-modules": "^0.36.5",
    "react-test-renderer": "19.2.8",
    "release-it": "^21.0.2",
    "tsc-alias": "^1.9.4",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >= 25.0.0"
  },
  "packageManager": "pnpm@10.33.2"
}
