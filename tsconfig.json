{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "verbatimModuleSyntax": true,
    "module": "ESNext",
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src"],
  // Build config: emits declarations for the published package only. Tests are
  // typechecked separately via tsconfig.check.json, which can reach outside
  // `rootDir` to the jest mocks.
  "exclude": ["src/**/*.test.ts", "src/**/*.test.tsx"]
}
